{
  "name": "nuxt-template-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "lhci autorun",
    "test:quality": "nuxt generate && lhci autorun",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@nuxt/fonts": "latest",
    "@nuxtjs/color-mode": "latest",
    "@nuxtjs/i18n": "latest",
    "@nuxtjs/seo": "latest",
    "@tailwindcss/vite": "^4.0.0",
    "@takumi-rs/core": "^2.13.3",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "latest",
    "better-sqlite3": "^12.2.0",
    "nuxt": "^4.0.0",
    "nuxt-auth-utils": "^0.5.30",
    "tailwindcss": "^4.0.0",
    "valibot": "latest",
    "vue": "latest",
    "vue-i18n": "^11.4.10",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@lhci/cli": "^0.15.0",
    "@types/better-sqlite3": "^7.6.11",
    "@vite-pwa/nuxt": "^1.1.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "lefthook": "^1.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vue-eslint-parser": "^10.0.0"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
