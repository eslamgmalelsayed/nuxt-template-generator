# Copy to .env and fill in before `docker compose up`.

# Session cookie encryption — REQUIRED. 32+ random characters.
#   generate with: openssl rand -base64 48
NUXT_SESSION_PASSWORD=

# First-boot admin account. Seeded ONCE, only when the database is empty.
NUXT_ADMIN_EMAIL=admin@example.com
NUXT_ADMIN_PASSWORD=

# Stable secret so social/OG images keep working across rebuilds + instances.
#   generate with: npx nuxt-og-image generate-secret
NUXT_OG_IMAGE_SECRET=
